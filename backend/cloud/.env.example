HOST=127.0.0.1
PORT=3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set a model already installed on the inference server.
OLLAMA_MODEL=
# Generate a per-user token with npm run token:create -- team-user.
# Paste only the generated hash record here; never the plaintext token.
AI_AUTH_TOKENS=[]
# Gateway-only hosting: set a separate service secret of at least 32 characters.
# Leave AI_AUTH_TOKENS empty only when AI_GATEWAY_SECRET is configured.
# Never put this secret in the mobile app or commit the real .env file.
AI_GATEWAY_SECRET=
MODEL_TIMEOUT_MS=30000
MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=10
INTERNAL_MAX_INPUT_CHARS=8000
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=2048
