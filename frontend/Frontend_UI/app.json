{
  "expo": {
    "name": "Atria",
    "slug": "planner",
    "scheme": "ai-assistant-planner",
    "version": "0.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#191a1b"
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      "./plugins/with-cleartext",
      "./plugins/with-neutral-accent",
      [
        "expo-camera",
        {
          "cameraPermission": "사진을 찍어 메모와 파일 보관함에 저장하려고 카메라를 사용해요."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "소리를 녹음해 파일 보관함에 저장하려고 마이크를 사용해요."
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-status-bar",
      "expo-asset",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "파일 보관함에서 사진과 동영상을 불러오려고 사진 보관함에 접근해요.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-secure-store"
    ]
  }
}
