HOST=127.0.0.1
PORT=3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set a model already installed on the inference server.
OLLAMA_MODEL=
# Generate a per-user token with npm run token:create -- team-user.
# Paste only the generated hash record here; never the plaintext token.
AI_AUTH_TOKENS=[]
MODEL_TIMEOUT_MS=30000
MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=10
